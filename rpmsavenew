#
# action: help
#
help_help()
{
	echo "  $0 help [ACTION]"
	echo
	list_actions
}

do_help()
{
	if [[ $# == 0 ]]; then
		show_usage
		exit 0
	fi

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				help_${_ACTION//-/_}
				exit 0
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	local a=$1
	if ! member "$a" "${actions[@]}"; then
		error "unknown action: $a"
	fi

	echo "Action usage:"

	a=${a//-/_}
	help_"$a" "$a"
	exit 0
}

#
# main
#
list_actions()
{
	local a

	echo "Actions:"
	for a in "${actions[@]}"; do
		echo "  $a"
	done
}

show_usage()
{
	echo "Usage:"
	echo "  $0 -h|--help"
	echo "  $0 help help"
	echo "  $0 ACTION ..."
	echo

	list_actions
}

main()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				show_usage
				exit 0
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	if [[ $# == 0 ]]; then
		error "no action given"
	fi

	local a=$1
	error_if_unknown_action "$a"
	shift

	_ACTION="$a"
	a=${a//-/_}
	do_"$a" "$@"
}

main "$@"
