#
# action: archive
#
help_archive()
{
	echo "  $0 archive [--delete-directory] BODYNAME|EXISTING-DIR"
	echo "  $0 archive --help|-h"

	examples

	echo "  # $0 archive /root"
	echo "    => makes /root/rpmsave-PID-TIMESTAMP"
	echo "         and /root/rpmsave-PID-TIMESTAMP.tar"
	echo
	echo "  # $0 archive /root/no-such-dir"
	echo "    => makes /root/no-such-dir"
	echo "         and /root/no-such-dir.tar"
}

copy_out()
{
	local dest=${1#--dest=}
	shift

	cp --parents -ra "$@" "$dest"
}

do_archive_main()
{
	local dest

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(--dest=*)
				dest=$1
				shift
				break
				;;
			(*)
				break;
				;;
		esac
	done

	foreach_rpmsavenew \
		do_archive_main copy_out \
		"$dest" \
		-- "$@"
}

do_archive()
{
	local delete_directory

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				do_help "${_ACTION}"
				exit 0
				;;
			(--delete-directory)
				delete_directory=1
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	if [[ $# -eq 0 ]]; then
		error "no archive name or directory given"
	elif [[ $# -gt 1 ]]; then
		error "too many arguments: $@"
	fi

	if ! is_available date; then
		error "command not available: date"
	fi

	local N
	local D
	if [[ -d "$1" ]]; then
		D=$1
		N=$D/rpmsavenew-$$-$(date +'%Y%m%d-%H%M%S')
	else
		N=$1
	fi

	if [[ -z "$N" ]]; then
		error "empty string given as the name of the output target"
	fi

	mkdir -p "$N" || error "fail to do mkdir: $N"

	do_archive_main --dest="$N"
	local s=$?

	if [[ "$s" == 0 ]]; then
		tar cvf "$N".tar "$N"
		s="$?"
	else
		error "error in copy-out operation: $N"
	fi

	if [[ "$s" == 0 && -n "$D" ]]; then
		echo  "$N".tar
	fi

	if [[ "$s" == 0 && -n "$delete_directory" ]]; then
		rm -rf "$N"
	fi

	return $s
}

#
# action: help
#
help_help()
{
	echo "  $0 help [ACTION]"
	echo
	list_actions
}

do_help()
{
	if [[ $# == 0 ]]; then
		show_usage
		exit 0
	fi

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				do_help ${_ACTION}
				exit 0
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	local a=$1
	if ! member "$a" "${actions[@]}"; then
		error "unknown action: $a"
	fi

	echo "Action usage:"

	a=${a//-/_}
	help_"$a" "$a"
	exit 0
}

#
# action: confspec
#
help_confspec()
{
	echo "  $0 confspec [PKG...]"
	echo "  $0 confspec --help|-h"
}

do_confspec()
{
	local with_pkg
	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				do_help "${_ACTION}"
				exit 0
				;;
			(--with-pkg)
				with_pkg=$1
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	local p
	local -a pkgs

	if [[ $# -eq 0 ]]; then
		for p in $(rpm -qa); do
			pkgs+=( "$p" )
		done
	else
		for p in "$@"; do
			if ! pkgs+=( $(rpm -q "$p") ) ; then
				error "no such package: $p"
			fi
		done
	fi

	for p in "${pkgs[@]}"; do
		local c

		rpm -q --qf '[%{filenames}: %{fileflags:fflags}\n]' "$p" |
			while read c; do
				case "$c" in
					(*:\ cn)
						if [[ -n "${with_pkg}" ]]; then
							echo "new 	$p	${c%: cn}"
						else
							echo "new 	${c%: cn}"
						fi
						;;
					(*:\ c)
						if [[ -n "${with_pkg}" ]]; then
							echo "save	$p	${c%: c}"
						else
							echo "save	${c%: c}"
						fi
						;;
				esac
			done
	done
}

#
# main
#
list_actions()
{
	local a

	echo "Actions:"
	for a in "${actions[@]}"; do
		echo "  $a"
	done
}

show_usage()
{
	echo "Usage:"
	echo "  $0 -h|--help"
	echo "  $0 help help"
	echo "  $0 ACTION ..."
	echo

	list_actions
}

main()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				show_usage
				exit 0
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	if [[ $# == 0 ]]; then
		error "no action given"
	fi

	local a=$1
	error_if_unknown_action "$a"
	shift

	_ACTION="$a"
	a=${a//-/_}
	do_"$a" "$@"
}

main "$@"
