declare _ACTION=

declare -ra actions=(
	help
	list-files
	diff
	sha1
	ls-lZ
	# accept-new
	# remove-new
	# ask-ai
)

member()
{
	local elt=$1
	shift

	local e
	for e in "$@"; do
		if [[ "$e" == "$elt" ]]; then
			return 0
		fi
	done

	return 1
}

error()
{
	if [[ -n "$_ACTION" ]]; then
		echo -n "ERROR[$_ACTION]: "
	else
		echo -n "ERROR: "
	fi

	if [[ $# == 0 ]]; then
		echo "$1"
	else
		printf "$@"
		echo
	fi

	exit 1
} 1>&2

warning()
{
	if [[ -n "$_ACTION" ]]; then
		echo -n "warning[$_ACTION]: "
	else
		echo -n "warning: "
	fi

	if [[ $# == 0 ]]; then
		echo "$1"
	else
		printf "$@"
		echo
	fi
}

error_if_unknown_action()
{
	local a=$1

	if ! member "$a" "${actions[@]}"; then
		error "unknown action: $a"
	fi
}

#
# action: list-files
#
help_list_files()
{
	echo "  $0 list-files [--with-pkg] [--new|--save|--base|*--both*]"
	echo "  $0 list-files --help|-h"
}

do_list_files()
{
	local filter=both
	local with_pkg=
	local f
	local c

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				help_${_ACTION//-/_}
				exit 0
				;;
			(--with-pkg)
				with_pkg=1
				shift
				;;
			(--new)
				filter=new
				shift
				;;
			(--save)
				filter=save
				shift
				;;
			(--base)
				filter=base
				shift
				;;
			(--both)
				filter=both
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	local c
	for f in $(rpm -qa --configfiles); do
		# We expect a file name starting with '/'.
		case "$f" in
			(/*) ;;
			(*) continue;;
		esac

		if [[ -e "${f}".rpmsave ]]; then
			case "$filter" in
				(both|save)
					c="${f}.rpmsave"
					;;
				(base)
					c="${f}"
					;;
			esac
		elif [[ -e "${f}".rpmnew ]]; then
			case "$filter" in
				(both|new)
					c="${f}.rpmnew"
					;;
				(base)
					c="${f}"
					;;
			esac
		else
			c=
		fi

		if [[ -n "$c" ]]; then
			if [[ -n "${with_pkg}" ]]; then
				printf "%50s %s\n" $(rpm -qf "$f") "$c"
			else
				printf "%s\n" "$c"
			fi
		fi
	done
}

#
# action: diff
#
help_diff()
{
	echo "  $0 diff [--stat] [FILE...]"
	echo "  $0 diff --help|-h"
}

do_diff()
{
	local f
	local b
	local diffstat

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				help_${_ACTION//-/_}
				exit 0
				;;
			(--stat)
				diffstat=1
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	{
		if [[ $# -eq 0 ]]; then
			while read p f; do
				echo "#"
				echo "# package: $p"
				echo "#"
				echo "---"
				do_diff "$f"
				echo
			done < <(do_list_files --with-pkg --base)
			return 0
		fi

		for f in "$@"; do
			case "$f" in
				(*.rpmsave)
					f=${f%.rpmsave}
					;;
				(*.rpmnew)
					f=${f%.rpmnew}
					;;
			esac

			if [[ -e "${f}".rpmsave ]]; then
				diff -uN --color=always "${f}".rpmsave "${f}"
			elif [[ -e "${f}".rpmnew ]]; then
				diff -uN --color=always "${f}" "${f}".rpmnew
			else
				warning "no rpmnew or rpmsave for ${f}"
			fi
		done
	} | if [[ -n "${diffstat}" ]]; then
		diffstat
	else
		cat
	fi
}

#
# action: sha1
#
help_sha1()
{
	echo "  $0 sha1 [FILE...]"
	echo "  $0 sha1 --help|-h"
}

do_sha1()
{
	local f
	local b

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				help_${_ACTION//-/_}
				exit 0
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	{
		if [[ $# -eq 0 ]]; then
			while read p f; do
				echo "#"
				echo "# package: $p"
				echo "#"
				echo "---"
				do_sha1 "$f"
				echo
			done < <(do_list_files --with-pkg --base)
			return 0
		fi

		for f in "$@"; do
			case "$f" in
				(*.rpmsave)
					f=${f%.rpmsave}
					;;
				(*.rpmnew)
					f=${f%.rpmnew}
					;;
			esac

			if [[ -e "${f}".rpmsave ]]; then
				sha1sum "${f}".rpmsave
				sha1sum "${f}"
			elif [[ -e "${f}".rpmnew ]]; then
				sha1sum "${f}"
				sha1sum "${f}".rpmnew
			else
				warning "no rpmnew or rpmsave for ${f}"
			fi
		done
	}
}

