#
# common helpers
#
member()
{
	local elt=$1
	shift

	local e
	for e in "$@"; do
		if [[ "$e" == "$elt" ]]; then
			return 0
		fi
	done

	return 1
}

error()
{
	if [[ -n "$_ACTION" ]]; then
		echo -n "ERROR[$_ACTION]: "
	else
		echo -n "ERROR: "
	fi

	if [[ $# == 0 ]]; then
		echo "$1"
	else
		printf "$@"
		echo
	fi

	exit 1
} 1>&2

warning()
{
	if [[ -n "$_ACTION" ]]; then
		echo -n "warning[$_ACTION]: "
	else
		echo -n "warning: "
	fi

	if [[ $# == 0 ]]; then
		echo "$1"
	else
		printf "$@"
		echo
	fi
}

error_if_unknown_action()
{
	local a=$1

	if ! member "$a" "${actions[@]}"; then
		error "unknown action: $a"
	fi
}

options()
{
	echo
	echo "Options:"
}

examples()
{
	echo
	echo "Examples:"
}

print_option()
{
	printf "  %-12s %s\n" "$@"
}

# 1: unsupported
# 0: supported
declare -i _grep_supports_pcre=
grep_supports_pcre()
{
	if [[ -n "${_grep_supports_pcre}" ]]; then
		return ${_grep_supports_pcre}
	fi

	grep -P xxx < /dev/null 2> /dev/null
	if [[ $? == 2 ]]; then
		_grep_supports_pcre=1
		return 1
	else
		_grep_supports_pcre=0
		return 0
	fi
}

is_available()
{
	type $1 >/dev/null 2>&1
}

foreach_rpmsavenew()
{
	local one_by_one=
	local with_pkg=
	local pkg=

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				do_help "${_ACTION}"
				exit 0
				;;
			(--one-by-one)
				one_by_one=1
				shift
				;;
			(--with-pkg)
				with_pkg=1
				shift
				;;
			(--pkg=*)
				pkg=${1#--pkg=}
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	local p f
	local r=0

	local self=$1
	local proc=$2
	shift 2

	local -a opts
	while [[ $# -gt 0 ]]; do
		case "$1" in
			(--)
				shift
				break
				;;
			(*)
				opts+=("$1")
				shift
				;;
		esac
	done

	if [[ $# -eq 0 ]]; then
		while read p f; do
			if [[ -n "$with_pkg" ]]; then
				echo "#"
				echo "# package: $p"
				echo "#"
				echo "---"
			fi

			"$self" "${opts[@]}" "$f" || r=1

			if [[ -n "$with_pkg" ]]; then
				echo
			fi
		done < <(do_list_files --with-pkg --base $pkg)
		return $r
	fi

	for f in "$@"; do
		case "$f" in
			(*.rpmsave)
				f=${f%.rpmsave}
				;;
			(*.rpmnew)
				f=${f%.rpmnew}
				;;
		esac

		if [[ -e "${f}".rpmsave ]]; then
			if [[ -n "${one_by_one}" ]]; then
				$proc "${opts[@]}" "${f}".rpmsave || r=1
				$proc "${opts[@]}" "${f}" || r=1
			else
				$proc "${opts[@]}" "${f}".rpmsave "${f}"
			fi
		elif [[ -e "${f}".rpmnew ]]; then
			if [[ -n "${one_by_one}" ]]; then
				$proc "${opts[@]}" "${f}" || r=1
				$proc "${opts[@]}" "${f}".rpmnew || r=1
			else
				$proc "${opts[@]}" "${f}" "${f}".rpmnew || r=1
			fi
		else
			warning "no rpmnew or rpmsave for ${f}"
		fi
	done
	return $r
}

