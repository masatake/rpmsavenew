#
# action: list-files
#
help_list_files()
{
	echo "  $0 list-files [--with-pkg] [--new|--save|--base|*--both*] [PKG...]"
	echo "  $0 list-files --help|-h"
}

do_list_files()
{
	local filter=both
	local with_pkg=
	local f
	local c

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				do_help "${_ACTION}"
				exit 0
				;;
			(--with-pkg)
				with_pkg=1
				shift
				;;
			(--new)
				filter=new
				shift
				;;
			(--save)
				filter=save
				shift
				;;
			(--base)
				filter=base
				shift
				;;
			(--both)
				filter=both
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	local c
	local aflag=

	if [[ $# -eq 0 ]]; then
		aflag=a
	fi

	for f in $(rpm -q${aflag} --configfiles "$@"); do
		# We expect a file name starting with '/'.
		case "$f" in
			(/*) ;;
			(*) continue;;
		esac

		if [[ -e "${f}".rpmsave ]]; then
			case "$filter" in
				(both|save)
					c="${f}.rpmsave"
					;;
				(base)
					c="${f}"
					;;
			esac
		elif [[ -e "${f}".rpmnew ]]; then
			case "$filter" in
				(both|new)
					c="${f}.rpmnew"
					;;
				(base)
					c="${f}"
					;;
			esac
		else
			c=
		fi

		if [[ -n "$c" ]]; then
			if [[ -n "${with_pkg}" ]]; then
				printf "%50s %s\n" $(rpm -qf "$f") "$c"
			else
				printf "%s\n" "$c"
			fi
		fi
	done
}

#
# action: diff
#
help_diff()
{
	echo "  $0 diff [options] [FILE...]"
	echo "  $0 diff [options] --pkg PKG"
	echo "  $0 diff --help|-h"

	options
	print_option --stat "generate diffstat"
	print_option --with-pkg "add package information to the output"
	print_option '--color=auto|always|never' "use markers to highlight the matching strings"
	print_option '--ignore-case' "ignore case differences in file contents"
	print_option '--ignore-tab-expansion' "ignore changes due to tab expansion"
	print_option '--ignore-trailing-space' "ignore white space at line end"
	print_option '--ignore-space-change' "ignore changes in the amount of white space"
	print_option '--ignore-all-space' "ignore all white space"
	print_option '--ignore-blank-lines' "ignore changes where lines are all blank"
	print_option '--ignore-sh-comments' "ignore changes starting from '#'"
}

diff_main()
{
	diff -uN "$@"
}

ignore_sh_comments()
{
	if grep_supports_pcre; then
		grep -P -v $'^(?:\x1b\\[[0-9;]*m)*[-+](?:\x1b\\[[0-9;]*m)*[ \t]*(?:\x1b\\[[0-9;]*m)*#'
	else
		cat
	fi | grep -v $'^[-+][ \t]*#.*$'
}

ignore_blank_lines()
{
	if grep_supports_pcre; then
		grep -P -v $'^(?:\x1b\\[[0-9;]*m)*[-+](?:\x1b\\[[0-9;]*m)*[ \t]*(?:\x1b\\[[0-9;]*m)*$'
	else
		cat
	fi | grep -v $'^[-+][ \t]*$'
}

do_diff()
{
	local f
	local b
	local diffstat
	local with_pkg=
	local color=auto

	local -a ignore
	local ignore_sh_comments=
	local ignore_blank_lines=

	local pkg

	while [[ $# -gt 0 ]]; do
		case "$1" in
			(-h|--help)
				do_help "${_ACTION}"
				exit 0
				;;
			(--stat)
				if ! is_available diffstat; then
					error "Command not available: diffstat"
				fi
				diffstat=1
				shift
				;;
			(--with-pkg)
				with_pkg=$1
				shift
				;;
			(--pkg=*)
				pkg=$1
				shift
				break
				;;
			(--pkg)
				shift
				pkg="--pkg=$1"
				if [[ -z "$pkg" ]]; then
					error "No package given to --pkg option"
				fi
				shift
				break
				;;
			(--color=*)
				color=${1#--color=}
				shift
				;;
			(--color)
				shift
				color=$1
				shift
				;;
			(--ignore-case|--ignore-tab-expansion|--ignore-trailing-space|--ignore-space-change|--ignore-all-space)
				ignore+=("$1")
				shift
				;;
			(--ignore-blank-lines)
				ignore+=("$1")
				ignore_blank_lines=1
				shift
				;;
			(--ignore-sh-comments)
				ignore+=($'--ignore-matching-lines=^[ \t]*#.*')
				ignore_sh_comments=1
				shift
				;;
			(--ignore-matching-lines=*)
				ignore+=("$1")
				shift
				;;
			(-*)
				error "unknown option: $1"
				;;
			(*)
				break
				;;
		esac
	done

	if ! member "$color" auto always never; then
		error "unexpected option argument for --color: $color"
	fi

	if [[ -n "${diffstat}" && "$color" == "always" ]]; then
		error "don't combine --stat and --color=always"
	fi

	if [[ -n "${ignore_sh_comments}" || -n "${ignore_blank_lines}" ]]; then
		if [[ -n "${diffstat}" ]]; then
			if [[ -n "${ignore_sh_comments}" ]]; then
				error "don't combine --stat and --ignore-sh-comments"
			elif [[ -n "${ignore_blank_lines}" ]]; then
				error "don't combine --stat and --ignore-blank-lines"
			fi
		fi
		if ! grep_supports_pcre && [[ "$color" == "always" ]]; then
			if [[ -n "${ignore_sh_comments}" ]]; then
				error "your grep doesn't support -P option; don't combine --color=always and --ignore-sh-comments"
			elif [[ -n "${ignore_blank_lines}" ]]; then
				error "your grep doesn't support -P option; don't combine --color=always and --ignore-blank-lines"
			fi
		fi
		if ! grep_supports_pcre && [[ "$color" == "auto" ]]; then
			color=never
		fi
	fi

	if [[ -n "${diffstat}" ]]; then
		color=never
	elif [[ -t 1 ]]; then
		if [[ "$color" == auto ]]; then
			color=always
		fi
	fi

	{
		foreach_rpmsavenew \
			$with_pkg \
			$pkg \
			"do_${_ACTION//-/_}" "${_ACTION//-/_}"_main \
			--color="$color" \
			"${ignore[@]}" \
			-- "$@"
	} | if [[ -n "${diffstat}" ]]; then
		diffstat
	else
		cat
	fi | if [[ -n "$ignore_sh_comments" ]]; then
		ignore_sh_comments
	else
		cat
	fi | if [[ -n "$ignore_blank_lines" ]]; then
		ignore_blank_lines
	else
		cat
	fi
}

